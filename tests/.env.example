# ───────────────────────────────────────────────────────────
#  Beauté Halal — configuration de l'API
#  Copiez ce fichier en « .env » puis adaptez les valeurs.
# ───────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# URL publique de l'API (sert à construire les liens des images)
API_URL=http://localhost:4000

# ── Base de données MySQL / MariaDB (XAMPP, WAMP, Laragon…) ──
# Valeurs par défaut de XAMPP : utilisateur « root », mot de passe vide.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=beaute_halal

# ── Origines autorisées à appeler l'API (front Vite) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Sécurité ──
# ⚠️ Remplacez impérativement par une longue chaîne aléatoire en production.
JWT_SECRET=changez-cette-cle-secrete-par-une-chaine-longue-et-aleatoire
JWT_EXPIRES_IN=12h

# ── Compte administrateur créé par « npm run db:seed » ──
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@beaute-halal.local
ADMIN_PASSWORD=ChangeMoi2026!

# ── E-mails (désactivés par défaut : tout est écrit dans la console) ──
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Beauté Halal <contact@beaute-halal.example>
# Adresse qui reçoit les notifications (nouveau RDV, nouveau message)
MAIL_ADMIN_RECIPIENT=contact@beaute-halal.example

# ── Upload d'images ──
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
