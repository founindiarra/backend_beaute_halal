# ───────────────────────────────────────────────────────────
#  Beauté Halal — configuration de l'API
#  Copiez ce fichier en « .env » puis adaptez les valeurs.
# ───────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# URL publique de l'API (sert à construire les liens des images)
API_URL=http://localhost:4000

# ── Base de données MySQL / MariaDB (XAMPP, WAMP, Laragon…) ──
# Valeurs par défaut de XAMPP : utilisateur « root », mot de passe vide.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=beaute_halal

# ── Origines autorisées à appeler l'API (front Vite) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Sécurité ──
# ⚠️ Remplacez impérativement par une longue chaîne aléatoire en production.
JWT_SECRET=changez-cette-cle-secrete-par-une-chaine-longue-et-aleatoire
JWT_EXPIRES_IN=12h

# ── Compte administrateur créé par « npm run db:seed » ──
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@beaute-halal.local
ADMIN_PASSWORD=ChangeMoi2026!

# ── E-mails (désactivés par défaut : tout est écrit dans la console) ──
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Beauté Halal <contact@beaute-halal.example>
# Adresse qui reçoit les notifications (nouveau RDV, nouveau message)
MAIL_ADMIN_RECIPIENT=contact@beaute-halal.example

# ── Upload d'images ──
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ══════════════════════════ SMS — passerelle KYA SMS ══════════════════════
#
# La passerelle se règle ENTIÈREMENT ici : aucun jeton d'API ne doit passer
# par le navigateur. Le tableau de bord lit seulement l'état (« prête » ou
# « il manque telle variable ») via /admin/messaging/status.
#
# Les quatre dernières variables sont les NOMS DES CHAMPS attendus par le
# fournisseur. Ils varient d'une passerelle à l'autre : si l'envoi échoue,
# utilisez le bouton « Essai » de la page Messagerie — il affiche la réponse
# brute de KYA SMS, qui dit en général quel champ manque ou n'est pas reconnu.
#
SMS_ENABLED=false
# L'adresse exacte de l'API d'envoi, fournie par KYA SMS.
SMS_API_URL=
SMS_API_METHOD=POST
# Le jeton / la clé d'API. NE JAMAIS le committer avec une vraie valeur.
SMS_API_TOKEN=
# Le nom d'expéditeur affiché sur le téléphone de la cliente (souvent 11
# caractères maximum, à faire approuver par l'opérateur).
SMS_SENDER_ID=BeauteHalal
# Comment le jeton est transmis : bearer | header | body
SMS_AUTH_MODE=bearer
# Utilisé seulement si SMS_AUTH_MODE=header (ex. : X-API-KEY)
SMS_AUTH_HEADER=
# json | form
SMS_CONTENT_TYPE=json
# Noms des champs attendus par le fournisseur
SMS_FIELD_TO=to
SMS_FIELD_MESSAGE=message
SMS_FIELD_SENDER=sender
# Utilisé seulement si SMS_AUTH_MODE=body
SMS_FIELD_TOKEN=
# Champs supplémentaires éventuels, séparés par des virgules (ex. : type=sms)
SMS_EXTRA_FIELDS=
# Envoyer les numéros au format international (225XXXXXXXX) plutôt que local
SMS_INTERNATIONAL_FORMAT=true
SMS_TIMEOUT_MS=15000
