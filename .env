# ══════════════════════════ SMS — passerelle KYA SMS ══════════════════════
#
# La clé API reste uniquement sur le serveur.
# Ne jamais mettre la clé API dans le frontend ou dans le dépôt Git.
#

SMS_ENABLED=true

# API KYA SMS V3
SMS_API_URL=https://route.kyasms.com/api/v3/sms/send
SMS_API_METHOD=POST

# Clé API KYA SMS
SMS_API_TOKEN=kyasmsd2ccf32b4aa62311eee9da3051b60bba18bb5236249abf9d1c5e5e873f

# Sender ID approuvé par KYA SMS
SMS_SENDER_ID=AEEMCI

# KYA utilise l'en-tête APIKEY (et non Bearer)
SMS_AUTH_MODE=header
SMS_AUTH_HEADER=APIKEY

# KYA attend du JSON
SMS_CONTENT_TYPE=json

# Champs du JSON KYA
SMS_FIELD_TO=to
SMS_FIELD_MESSAGE=message
SMS_FIELD_SENDER=from

# La clé API n'est pas envoyée dans le corps
SMS_FIELD_TOKEN=

# KYA demande le type de SMS
SMS_EXTRA_FIELDS=type=text

# Format international
SMS_INTERNATIONAL_FORMAT=true

# Délai maximum de réponse
SMS_TIMEOUT_MS=15000
